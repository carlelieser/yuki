{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@ui": ["./src/lib"],
			"@ui/*": ["./src/lib/*"]
		},
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"checkJs": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "svelte.config.ts"]
}
